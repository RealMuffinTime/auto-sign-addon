{
  "schemaVersion": 1,
  "id": "auto-sign-addon",
  "version": "${version}",
  "name": "Auto Sign Addon",
  "description": "Improvements to the default Auto Sign module.",
  "authors": [
    "RealMuffinTime"
  ],
  "contact": {
    "sources": "https://github.com/RealMuffinTime/auto-sign-addon"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "tk.muffintime.autoSignAddon.AutoSignAddon"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}", "1.21.9"],
    "meteor-client": "*"
  }
}
